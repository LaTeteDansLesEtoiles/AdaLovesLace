<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="AdaLovesLace Custom Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset/2.0.0.0.xsd">
  <description>
    PMD 7 rules for AdaLovesLace. Uses the official quickstart set (practical for JavaFX/UI code)
    plus NcssCount for Rule 000 size limits. Full category/*.xml sets are far stricter and were
    never meaningfully applied while PMD 6 failed to parse Java 24 sources.
  </description>

  <rule ref="rulesets/java/quickstart.xml">
    <!-- Java 21+ allows unnamed lambda parameters (__); rule expects [a-z]... -->
    <exclude name="FormalParameterNamingConventions"/>
    <!-- SLF4J parameterized logging is cheap; guarding every debug/trace adds noise without benefit here. -->
    <exclude name="GuardLogStatement"/>
    <!-- Static wiring / inner-class context: fully-qualified names are often intentional for clarity. -->
    <exclude name="UnnecessaryFullyQualifiedName"/>
    <exclude name="UselessParentheses"/>
    <!-- Matches legacy static App/Diagram shell; same rationale as SpotBugs ST_WRITE_TO_STATIC exclusions. -->
    <exclude name="AssignmentToNonFinalStatic"/>
    <!-- Single-line if/for/while without braces is common in UI glue code; braces rule is very noisy. -->
    <exclude name="ControlStatementBraces"/>
    <!-- Identity vs equality: JavaFX nodes, ButtonType, and knot references rely on reference semantics. -->
    <exclude name="CompareObjectsWithEquals"/>
    <!-- Knot typedText is an intentional mutable builder field in the domain model. -->
    <exclude name="AvoidStringBufferField"/>
  </rule>

  <!-- Rule 000: method / class size (replaces removed ExcessiveMethodLength / ExcessiveClassLength) -->
  <rule ref="category/java/design.xml/NcssCount">
    <properties>
      <!-- Largest known method NCSS in domain UI glue (~172); keep a margin without exempting huge classes. -->
      <property name="methodReportLevel" value="230"/>
      <property name="classReportLevel" value="500"/>
    </properties>
  </rule>
</ruleset>
